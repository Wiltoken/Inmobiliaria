# =============================================================================
# Inmobiliaria Platform — Environment Variables Reference
# Copy to .env and fill in values. All values here match pydantic-settings fields.
# =============================================================================

# --- REQUIRED ---
# JWT signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://inmuebles:changeme@localhost:5432/inmobiliaria_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- S3 / Object Storage ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=inmobiliaria-photos
S3_REGION=us-east-1

# --- Security: Login & Lockout ---
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=15

# --- Security: Tokens ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
INACTIVITY_TIMEOUT_MINUTES=30

# --- Security: Password Policy ---
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_EXPIRY_DAYS=30

# --- Security: reCAPTCHA v3 ---
RECAPTCHA_ENABLED=false
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Security: Anti-clipboard paste (UI concern, backend validates) ---
COPY_PASTE_RESTRICTED=false

# --- Compliance (Colombian Ley 1581/2012) ---
AUDIT_RETENTION_DAYS=365

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_SECOND=5
RATE_LIMIT_WINDOW_SECONDS=1

# --- SMTP Notification (for password reset) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@inmobiliaria.local

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Matching ---
MATCH_CACHE_TTL_SECONDS=3600

# --- PostGIS ---
POSTGIS_ENABLED=true
